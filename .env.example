# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# YOUTUBE_API_KEY: Optional/Third-party key for authentic YouTube Data API v3 calls.
# Keep server-side only for security. If missing, a simulation fallback will handle live statuses seamlessly.
# You can also supply comma-separated keys in YOUTUBE_API_KEYS for automatic pool rotation & quota failover.
YOUTUBE_API_KEY=""
YOUTUBE_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configurations
# Note: Use public anon key for browser-side VITE_SUPABASE_ANON_KEY (or 3ASE_ANON_KEY).
# NEVER use SUPABASE_SERV (service_role secret key) in client-side code.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

